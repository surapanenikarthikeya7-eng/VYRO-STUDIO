# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional. Connection string for MongoDB Atlas.
# If not supplied, the app will run with a self-contained persistent file-based JSON store for zero-config demonstration.
MONGODB_URI="mongodb+srv://..."

# JWT_SECRET: Secret key used to sign and verify JSON Web Tokens for the Admin Dashboard.
JWT_SECRET="pixel_studio_secret_key_123!"

# ADMIN_USERNAME: Username for the protected Admin Dashboard.
ADMIN_USERNAME="admin"

# ADMIN_PASSWORD: Password for the protected Admin Dashboard.
ADMIN_PASSWORD="pixelstudio2026"

# GMAIL NOTIFICATION SERVICE (Backend optional SMTP / Google Workspace settings)
# If provided, the server can dispatch automated emails directly via secure Gmail SMTP
# in addition to the Admin Dashboard's real-time Google Workspace Gmail OAuth token.
GMAIL_USER="vyrostudo@gmail.com"
GMAIL_APP_PASSWORD=""
ENABLE_AUTOMATIC_BOOKING_EMAILS="true"
ENABLE_AUTOMATIC_CANCELLATION_EMAILS="true"
ENABLE_AUTOMATIC_COMPLETION_EMAILS="true"
