rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'vyrostudo@gmail.com' ||
          request.auth.token.email.lower() == 'vyrostudo@gmail.com' ||
          request.auth.token.email == 'surapanenikarthikeya7@gmail.com' ||
          request.auth.token.email.lower() == 'surapanenikarthikeya7@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User profiles & accounts (allows persistent cross-device authentication)
    match /users/{userId} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Studio member cross-device credential registry
    match /studio_users/{userKey} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }

    // Admin records
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == adminId);
      allow delete: if isAdmin();
    }

    // Bookings
    match /bookings/{bookingId} {
      allow read: if isAdmin() || (isSignedIn() && (
        existing().userId == request.auth.uid ||
        existing().email == request.auth.token.email
      ));
      allow create: if isSignedIn() && incoming().name is string && incoming().email is string;
      allow update: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    // Portfolio items - public read, admin write
    match /portfolio/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Studio services and pricing - public read, admin write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Global settings & branding - public read, admin write
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
      allow delete: if isAdmin();
    }

    // Email notifications history & status tracking
    match /email_notifications/{notificationId} {
      allow read: if isAdmin() || (isSignedIn() && (
        existing().recipientEmail == request.auth.token.email ||
        existing().senderEmail == request.auth.token.email
      ));
      allow create: if isSignedIn();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
